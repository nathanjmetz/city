; Engine configuration file.
config_version=5

[application]

config/name="Neighbors"
config/description="A cozy 3D city builder."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/brand/app-icons/icon-256.png"
config/windows_native_icon="res://assets/brand/app-icons/neighbors.ico"

[autoload]

Session="*res://scripts/shell/session.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2

[shader_globals]

night={
"type": "float",
"value": 0.0
}
snow={
"type": "float",
"value": 0.0
}
season_look={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
windows_lit={
"type": "float",
"value": 0.0
}
