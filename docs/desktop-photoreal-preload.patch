 	_chunks.erase(key)
 	_dirty.erase(key)
 	_mark(key, false)
@@ -712,6 +731,8 @@ func _drop(key: Vector2i) -> void:
 func _build(key: Vector2i, lod: int, data := {}) -> void:
 	if _chunks.has(key):
 		_drop(key)
+	if data.is_empty():
+		data = _cache.get(key, {}).get(lod, {})
 	if data.is_empty():
 		data = chunk_data(Vector2(key) * CHUNK, CHUNK, STEPS[lod], REACH[lod] if lod < STEPS.size() - 1 else 0.0)
 	var meshes := [data.ground, data.water]
@@ -733,6 +754,55 @@ func _build(key: Vector2i, lod: int, data := {}) -> void:
 	_mark(key, true)
 
 
+func _keep(key: Vector2i, lod: int, data: Dictionary) -> void:
+	if not _cache_on or data.is_empty():
+		return
+	if not _cache.has(key):
+		if _cached >= CACHE_MAX:
+			return
+		_cache[key] = {}
+	if not _cache[key].has(lod):
+		_cached += 1
+	_cache[key][lod] = data
+
+
+## Forgets a chunk's kept land (it was graded under a new road).
+func _forget(key: Vector2i) -> void:
+	if _cache.has(key):
+		_cached -= _cache[key].size()
+		_cache.erase(key)
+
+
+## In spare frame time, builds the coarse levels of the whole county ahead
+## of the camera, nearest first (desktop only).
+func _preload_step(flat_eye: Vector2, start: int) -> void:
+	if not _cache_on or _cached >= CACHE_MAX:
+		return
+	if not _preload_ready:
+		_preload_ready = true
+		var mid := Terrain.CENTRE - Terrain.view_origin
+		var half := ceili(Terrain.SIZE * 0.5 / CHUNK)
+		var c0 := Vector2i(floori(mid.x / CHUNK), floori(mid.y / CHUNK))
+		for lod in PRELOAD_LODS:
+			var ring := []
+			for cz in range(c0.y - half, c0.y + half):
+				for cx in range(c0.x - half, c0.x + half):
+					ring.append(Vector2i(cx, cz))
+			ring.sort_custom(func(a, b): return _chunk_distance(a, flat_eye) > _chunk_distance(b, flat_eye))
+			var level := []
+			for key in ring:
+				level.append([key, lod])
+			# The coarsest level first: it is popped from the back.
+			_preload = level + _preload
+	while not _preload.is_empty() and Time.get_ticks_msec() - start < _budget_ms:
+		var item: Array = _preload.pop_back()
+		var key: Vector2i = item[0]
+		var lod: int = item[1]
+		if _cache.get(key, {}).has(lod) or (_chunks.has(key) and _chunks[key].lod == lod):
+			continue
+		_keep(key, lod, chunk_data(Vector2(key) * CHUNK, CHUNK, STEPS[lod], REACH[lod] if lod < STEPS.size() - 1 else 0.0))
+
+
 func _mark(key: Vector2i, built: bool) -> void:
 	_mask.set_pixel(key.x & (MASK - 1), key.y & (MASK - 1), Color.WHITE if built else Color.BLACK)
 	_mask_dirty = true
@@ -1260,6 +1330,7 @@ func _mark_dirty(g: Array) -> void:
 				# (one half built starts over).
 				if _job.get("key") == key:
 					_job = {}
+				_forget(key)
 				if not _chunks.has(key):
 					continue
 				if not _dirty.has(key):
