 const MASK := 64
+## The desktop app keeps every chunk it has built (up to this many), and in
+## spare time builds the two coarsest levels for the whole county ahead of
+## the camera, so scrolling back or far only puts ready land on screen.
+const CACHE_MAX := 8000
+const PRELOAD_LODS := [4, 3]
 ## How far the camera moves (metres, height counted) before the chunks'
 ## detail levels are worked out again; far smaller than any level's reach.
 const SETTLE_MOVE := 8.0
@@ -452,6 +457,11 @@ var _mask := Image.create(MASK, MASK, false, Image.FORMAT_L8)
 var _mask_tex: ImageTexture
 var _mask_dirty := true
 var _budget_ms := BUDGET_MS if OS.has_feature("web") else DESKTOP_BUDGET_MS
+var _cache_on := not OS.has_feature("web")
+var _cache := {}  # Vector2i chunk -> {lod: chunk data}
+var _cached := 0
+var _preload: Array = []  # [key, lod] still to build, nearest last
